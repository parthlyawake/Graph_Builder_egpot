<node id="emailservice/logger.py:CustomJsonFormatter">
  <data key="d0">emailservice/logger.py:CustomJsonFormatter</data>
  <data key="d1">class</data>
  <data key="d2">Lsyn</data>
  <data key="d3">CustomJsonFormatter</data>
  <data key="d4">emailservice/logger.py</data>
  <data key="d5">emailservice</data>
  <data key="d6">23</data>
  <data key="d13"></data>
  <data key="d7">class CustomJsonFormatter(jsonlogger.JsonFormatter):
  def add_fields(self, log_record, record, message_dict):
    super(CustomJsonFormatter, self).add_fields(log_record, record, message_dict)
    if not log_record.get('timestamp'):
      log_record['timestamp'] = record.created
    if log_record.get('severity'):
      log_record['severity'] = log_record['severity'].upper()
    else:
      log_record['severity'] = record.levelname</data>
  <data key="d14">False</data>
</node>
