<node id="emailservice/email_server.py:BaseEmailService">
  <data key="d0">emailservice/email_server.py:BaseEmailService</data>
  <data key="d1">class</data>
  <data key="d2">Lsyn</data>
  <data key="d3">BaseEmailService</data>
  <data key="d4">emailservice/email_server.py</data>
  <data key="d5">emailservice</data>
  <data key="d6">52</data>
  <data key="d13"></data>
  <data key="d7">class BaseEmailService(demo_pb2_grpc.EmailServiceServicer):
  def Check(self, request, context):
    return health_pb2.HealthCheckResponse(
      status=health_pb2.HealthCheckResponse.SERVING)
  
  def Watch(self, request, context):
    return health_pb2.HealthCheckResponse(
      status=health_pb2.HealthCheckResponse.UNIMPLEMENTED)</data>
  <data key="d14">False</data>
</node>
