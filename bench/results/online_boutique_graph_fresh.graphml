<node id="emailservice/logger.py:getJSONLogger">
  <data key="d0">emailservice/logger.py:getJSONLogger</data>
  <data key="d1">function</data>
  <data key="d2">Lsyn</data>
  <data key="d3">getJSONLogger</data>
  <data key="d4">emailservice/logger.py</data>
  <data key="d5">emailservice</data>
  <data key="d6">33</data>
  <data key="d13"></data>
  <data key="d7">def getJSONLogger(name):
  logger = logging.getLogger(name)
  handler = logging.StreamHandler(sys.stdout)
  formatter = CustomJsonFormatter('%(timestamp)s %(severity)s %(name)s %(message)s')
  handler.setFormatter(formatter)
  logger.addHandler(handler)
  logger.setLevel(logging.INFO)
  logger.propagate = False
  return logger</data>
  <data key="d14">False</data>
</node>
