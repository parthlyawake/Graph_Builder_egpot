      <data key="d8">PageHandler::PageHandler(
    ClientPool&lt;ThriftClient&lt;MovieReviewServiceClient&gt;&gt; *movie_review_client_pool,
    ClientPool&lt;ThriftClient&lt;MovieInfoServiceClient&gt;&gt; *movie_info_client_pool,
