    <node id="SocialGraph/SocialGraphHandler.h:social_network.InsertUser">
      <data key="d0">SocialGraph/SocialGraphHandler.h:social_network.InsertUser</data>
      <data key="d1">function</data>
      <data key="d2">Lsyn</data>
      <data key="d3">InsertUser</data>
