    <node id="Media/MediaService.cpp:sigintHandler">
      <data key="d0">Media/MediaService.cpp:sigintHandler</data>
      <data key="d1">function</data>
      <data key="d2">Lsyn</data>
      <data key="d3">sigintHandler</data>
