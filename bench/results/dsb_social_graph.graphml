    <node id="ComposePost/RabbitmqClient.h:social_network">
      <data key="d0">ComposePost/RabbitmqClient.h:social_network</data>
      <data key="d1">module</data>
      <data key="d2">Lsyn</data>
      <data key="d3">social_network</data>
