      <data key="d8">u_int16_t HashMacAddressPid(const std::string &amp;mac) {
  u_int16_t hash = 0;
  std::string mac_pid = mac + std::to_string(getpid());
  for (unsigned int i = 0; i &lt; mac_pid.size(); i++) {
    hash += (mac[i] &lt;&lt; ((i &amp; 1) * 8));
  }
  return hash;
}</data>
