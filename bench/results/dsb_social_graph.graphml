      bson_iter_init(&amp;iter_1, doc);

      while (bson_iter_find_descendant(
                 &amp;iter_0,
                 ("followers." + std::to_string(index) + ".user_id").c_str(),
                 &amp;user_id_child) &amp;&amp;
             BSON_ITER_HOLDS_INT64(&amp;user_id_child) &amp;&amp;
             bson_iter_find_descendant(
