    <node id="User/UserHandler.h:social_network.GetMachineId">
      <data key="d0">User/UserHandler.h:social_network.GetMachineId</data>
      <data key="d1">function</data>
      <data key="d2">Lsyn</data>
      <data key="d3">GetMachineId</data>
      <data key="d4">User/UserHandler.h</data>
      <data key="d5">User</data>
      <data key="d6">914</data>
      <data key="d7" />
      <data key="d8">std::string GetMachineId(std::string &amp;netif) {
  std::string mac_hash;

  std::string mac_addr_filename = "/sys/class/net/" + netif + "/address";
  std::ifstream mac_addr_file;
  mac_addr_file.open(mac_addr_filename);
  if (!mac_addr_file) {
    LOG(fatal) &lt;&lt; "Cannot read MAC address from net interface " &lt;&lt; netif;
    return "";
  }
  std::string mac;
  mac_addr_file &gt;&gt; mac;
  if (mac == "") {
    LOG(fatal) &lt;&lt; "Cannot read MAC address from net interface " &lt;&lt; netif;
    return "";
  }
  mac_addr_file.close();

  LOG(info) &lt;&lt; "MAC address = " &lt;&lt; mac;

  std::stringstream stream;
  stream &lt;&lt; std::hex &lt;&lt; HashMacAddressPid(mac);
  mac_hash = stream.str();

  if (mac_hash.size() &gt; 3) {
    mac_hash.erase(0, mac_hash.size() - 3);
  } else if (mac_hash.size() &lt; 3) {
    mac_hash = std::string(3 - mac_hash.size(), '0') + mac_hash;
  }
  return mac_hash;
}</data>
